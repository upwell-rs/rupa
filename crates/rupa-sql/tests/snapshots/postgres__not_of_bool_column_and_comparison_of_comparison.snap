---
source: crates/rupa-sql/tests/postgres.rs
expression: "pg(&where_(!bind(true))) + \"\\n---\\n\" + &pg(&where_(cmp.eq(true)))"
---
SELECT "id", "email", "nickname", "active", "created", "prefs", "old_prefs" FROM "app"."users" WHERE NOT $1
$1 = Bool(true)
---
SELECT "id", "email", "nickname", "active", "created", "prefs", "old_prefs" FROM "app"."users" WHERE ("id" = $1) = $2
$1 = I64(1)
$2 = Bool(true)
